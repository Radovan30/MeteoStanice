{
  "ConnectionStrings": {
    "MeteoDatabase": "Host=192.168.0.102;Port=32773;Database=meteostanice;Username=admin;Password=Wowstick0035!"
  },
  "Monitor": {
    "AppTitle": "Monitoring meteostanic",
    "ReevaluateIntervalSeconds": 30,
    "FallbackRefreshSeconds": 60,
    "SafetyRefreshMinutes": 5,
    "NotifyChannel": "meteo_monitor_changed",
    "DefaultMeasurementIntervalMinutes": 10,
    "OfflineAfterIntervals": 2.5,
    "EventLookbackHours": 24,
    "TimeLimitedEventMinutes": 60,
    "RestartWarningMinutes": 30,
    "Sound": {
      "Enabled": true,
      "RepeatSeconds": 60,
      "WavFile": "Sounds/alarm.wav",
      "AlarmOnHighPollution": true,
      "AlarmOnWarnings": false
    },
    "PressureReduction": {
      "DefaultAltitudeMeters": 242,
      "StationAltitudes": {
        "Poruba - Ostrava": 242
      },
      "UseMeasuredTemperature": true
    },
    "StationColors": [ "#4A90D9", "#EF8B3B", "#D2609A" ],
    "Pollutants": [
      { "Code": "pm1",  "Label": "PM1",   "Unit": "µg/m³", "Maximum": 100, "WarningThreshold": 15, "AlarmThreshold": 50,  "Color": "#8E24AA" },
      { "Code": "pm25", "Label": "PM2,5", "Unit": "µg/m³", "Maximum": 100, "WarningThreshold": 15, "AlarmThreshold": 50,  "Color": "#3949AB" },
      { "Code": "pm4",  "Label": "PM4",   "Unit": "µg/m³", "Maximum": 125, "WarningThreshold": 30, "AlarmThreshold": 75,  "Color": "#00ACC1" },
      { "Code": "pm10", "Label": "PM10",  "Unit": "µg/m³", "Maximum": 150, "WarningThreshold": 45, "AlarmThreshold": 100, "Color": "#6D4C41" }
    ],
    "EnvironmentGauges": [
      { "Code": "temperature", "Label": "Teplota", "Unit": "°C",  "Minimum": -20, "Maximum": 50,   "Decimals": 1, "Color": "#D32F2F" },
      { "Code": "humidity",    "Label": "Vlhkost", "Unit": "%",   "Minimum": 0,   "Maximum": 100,  "Decimals": 0, "Color": "#1E88E5", "WarningHigh": 85 },
      { "Code": "pressureSeaLevel", "Label": "Tlak (moře)", "Unit": "hPa", "Minimum": 960, "Maximum": 1050, "Decimals": 0, "Color": "#2E7D32", "Segments": 15 }
    ]
  }
}
